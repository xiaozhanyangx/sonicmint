{
  "name": "sonicmint",
  "version": "0.1.0",
  "description": "链上音乐发行平台 · 基于 TapeOut 协议（音频上链 + 播放版税即时结算）",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "node scripts/compile.js",
    "deploy": "node scripts/deploy.js",
    "upload-audio": "node scripts/upload-audio.js",
    "publish-site": "node scripts/publish-site.js",
    "build:crypto": "node scripts/build-crypto.js",
    "build:keeper": "node scripts/build-keeper.js",
    "keeper:key": "node scripts/keeper-key.js",
    "build:og": "node scripts/build-og.js",
    "deploy:keeper": "npx --yes wrangler@latest deploy --config keeper/wrangler.toml",
    "deploy:web": "npx --yes wrangler@latest pages deploy frontend --project-name sonicmint --branch main"
  },
  "dependencies": {
    "ethers": "^6.13.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.28.2",
    "solc": "^0.8.37"
  }
}
